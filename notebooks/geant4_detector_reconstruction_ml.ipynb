    "# add features function,help me to make new columns that help me to classify the particles by conventionally. \n",
    "\n",
    "def add_features(df):\n",
    "    df = df.copy()\n",
    "    df[\"ECAL_sum\"] = df[[\"EM1\",\"EM2\",\"EM3\",\"EM4\",\"EM5\"]].sum(axis=1)\n",
    "    df[\"HCAL_sum\"] = df[[\"HCAL1\",\"HCAL2\",\"HCAL3\",\"HCAL4\",\"HCAL5\"]].sum(axis=1)\n",
    "    df[\"Tracker_sum\"] = df[[\"Si1\",\"Si2\",\"Si3\",\"Si4\",\"Si5\"]].sum(axis=1)\n",
    "    df[\"Muon_sum\"] = df[\"MuonGas\"]\n",
    "\n",
    "    df[\"E_detected\"] = df[\"ECAL_sum\"] + df[\"HCAL_sum\"] + df[\"Tracker_sum\"] + df[\"Muon_sum\"]\n",
    "\n",
    "    eps = 1e-12\n",
    "    df[\"ECAL_frac\"] = df[\"ECAL_sum\"] / (df[\"E_detected\"] + eps)\n",
    "    df[\"HCAL_frac\"] = df[\"HCAL_sum\"] / (df[\"E_detected\"] + eps)\n",
    "    df[\"HCAL_over_ECAL\"] = df[\"HCAL_sum\"] / (df[\"ECAL_sum\"] + eps)\n",
    "    df[\"ECAL_front_frac\"] = (df[\"EM1\"] + df[\"EM2\"]) / (df[\"ECAL_sum\"] + eps)\n",
    "    df[\"HCAL_back_frac\"] = (df[\"HCAL4\"] + df[\"HCAL5\"]) / (df[\"HCAL_sum\"] + eps)\n",
    "\n",
    "    return df\n",
    "\n",
    "# Function that only use to identify the electrons and photons from the data set \n",
    "def pid_gamma_electron(row):\n",
    "    #threshold values \n",
    "    tracker_cut = 0.02\n",
    "    ecal_fraction_cut = 0.60\n",
    "    hadron_over_em_cut = 0.80\n",
    "\n",
    "    tracker = row[\"Tracker_sum\"]\n",
    "    ecal_frac = row[\"ECAL_frac\"]\n",
    "    hadron_over_electron = row[\"HCAL_over_ECAL\"]\n",
    "# Condition\n",
    "    if (ecal_frac > ecal_fraction_cut) and (hadron_over_electron < hadron_over_em_cut):\n",
    "        return \"gamma\" if tracker < tracker_cut else \"electron\"\n",
    "\n",
    "    return \"gamma\" if tracker < tracker_cut else \"electron\"\n",
    "\n",
    "# Function that  use to identify the particles(Electrons, photons,pi-,neutrons,muons- from the whole dataset\n",
    "def pid_full(row):\n",
    "    trk  = row[\"Tracker_sum\"]\n",
    "    ecal = row[\"ECAL_sum\"]\n",
    "    hcal = row[\"HCAL_sum\"]\n",
    "    mu   = row[\"Muon_sum\"]\n",
    "    Etot = row[\"E_detected\"] + 1e-12\n",
    "\n",
    "    ecal_frac = ecal / Etot\n",
    "    hcal_frac = hcal / Etot\n",
    "    h_over_e  = hcal / (ecal + 1e-12)\n",
    "    ecal_front = row[\"ECAL_front_frac\"]\n",
    "#threshold values \n",
    "    trk_thr = 0.02\n",
    "    mu_thr = 0.02\n",
    "#conditions\n",
    "    if (mu > mu_thr) and (trk > trk_thr) and (ecal_frac < 0.75) and (hcal_frac < 0.75):\n",
    "        return \"muon-\"\n",
    "\n",
    "    if (ecal_frac > 0.60) and (h_over_e < 0.80) and (ecal_front > 0.35):\n",
    "        return \"gamma\" if (trk < trk_thr) else \"electron\"\n",
    "\n",
    "    if trk < trk_thr:\n",
    "        return \"neutron\"\n",
    "\n",
    "    return \"pi-\"\n",
    "\n",
    "# Loading the data set\n",
    "def load_dataset(files, pid_function):\n",
    "    frames = []\n",
    "\n",
    "    for label, energy, path in files:\n",
    "        df = pd.read_csv(path, comment=\"#\", header=None, names=colnames)\n",
    "        df = add_features(df)\n",
    "        df[\"TruthLabel\"] = label\n",
    "        df[\"BeamEnergy_MeV\"] = energy\n",
    "        df[\"PredictedType\"] = df.apply(pid_function, axis=1)\n",
    "        frames.append(df)\n",
    "\n",
    "    return pd.concat(frames, ignore_index=True)\n",
    "\n",
    "# Function for finding the Calibration constant for the each file and different for different files and it helps to find the calibrated energy/reconstructed energy\n",
    "# more explanation in markdown\n",
    "\n",
    "def calibrate_detector(df, E_MIN=1.0):\n",
    "    df = df.copy()\n",
    "# protection from the worst values \n",
    "    good = df[\"E_detected\"] > E_MIN\n",
    "\n",
    "    if good.sum() == 0:\n",
    "        raise ValueError(\"No events passed the E_detected threshold for calibration.\")\n",
    "\n",
    "    C = (df.loc[good, \"TrueEnergy\"] / df.loc[good, \"E_detected\"]).mean()\n",
    "\n",
    "    df[\"CalibrationConstant\"] = C\n",
    "    df[\"E_calibrated\"] = C * df[\"E_detected\"]\n",
    "    df[\"FracResidual\"] = (df[\"E_calibrated\"] - df[\"TrueEnergy\"]) / df[\"TrueEnergy\"]\n",
    "    df[\"UsedForCalibration\"] = good\n",
    "\n",
    "    return df, C\n",
    "\n",
    "#Efficiency functions\n",
    "# Efficiency by the finding of particles\n",
    "def print_efficiency(df, pred_col=\"PredictedType\"):\n",
    "    correct = (df[\"TruthLabel\"] == df[pred_col]).sum()\n",
    "    total = len(df)\n",
    "    print(f\"Overall efficiency = {correct/total:.4f} ({correct}/{total})\")\n",
    "# Efficiency by the value of energy\n",
    "    print(\"\\nEfficiency by energy:\")\n",
    "    for E in sorted(df[\"BeamEnergy_MeV\"].unique()):\n",
    "        sub = df[df[\"BeamEnergy_MeV\"] == E]\n",
    "        c = (sub[\"TruthLabel\"] == sub[pred_col]).sum()\n",
    "        t = len(sub)\n",
    "        print(f\"{int(E):5d} MeV  efficiency = {c/t:.4f} ({c}/{t})\")\n",
    "\n",
    "# Function for the resolution \n",
    "def print_resolution(df, particles):\n",
    "    print(\"\\nResolution table:\")\n",
    "    for label in particles:\n",
    "        for E in sorted(df[\"BeamEnergy_MeV\"].unique()):\n",
    "            sub = df[(df[\"TruthLabel\"] == label) & (df[\"BeamEnergy_MeV\"] == E)]\n",
    "            if len(sub) > 1:\n",
    "                bias = sub[\"FracResidual\"].mean()\n",
    "                res = sub[\"FracResidual\"].std()\n",
    "                print(f\"{label:8s} {int(E):5d} MeV  bias={bias:+.4f}  resolution={res:.4f}\")\n",
    "\n",
    "# Plots\n",
    "def plot_energy_and_residuals(df, particles):\n",
    "    for particle in particles:\n",
    "        for E in sorted(df[\"BeamEnergy_MeV\"].unique()):\n",
    "            sub = df[(df[\"TruthLabel\"] == particle) & (df[\"BeamEnergy_MeV\"] == E)]\n",
    "            if len(sub) == 0:\n",
    "                continue\n",
    "\n",
    "            plt.figure(figsize=(7,5))\n",
    "            plt.hist(sub[\"E_calibrated\"], bins=40)\n",
    "            plt.xlabel(\"Calibrated energy (MeV)\")\n",
    "            plt.ylabel(\"Counts\")\n",
    "            plt.title(f\"Calibrated energy: {particle}, {int(E)} MeV\")\n",
    "            plt.tight_layout()\n",
    "            plt.show()\n",
    "\n",
    "            plt.figure(figsize=(7,5))\n",
    "            plt.hist(sub[\"FracResidual\"], bins=40)\n",
    "            plt.xlabel(\"(E_calibrated - E_true) / E_true\")\n",
    "            plt.ylabel(\"Counts\")\n",
    "            plt.title(f\"Fractional residual: {particle}, {int(E)} MeV\")\n",
    "            plt.tight_layout()\n",
    "            plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "46feaeda-8c38-4523-8ca8-549ec0aba5e1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# calibration Constant for different files \n",
    "def load_and_calibrate_per_file(files, pid_function, E_MIN=1.0):\n",
    "    frames = []\n",
    "    summary_rows = []\n",
    "\n",
    "    for label, energy, path in files:\n",
    "        df = pd.read_csv(path, comment=\"#\", header=None, names=colnames)\n",
    "        df = add_features(df)\n",
    "\n",
    "        df[\"TruthLabel\"] = label\n",
    "        df[\"BeamEnergy_MeV\"] = energy\n",
    "        df[\"PredictedType\"] = df.apply(pid_function, axis=1)\n",
    "\n",
    "        # calibrate this file only\n",
    "        df, C = calibrate_detector(df, E_MIN=E_MIN)\n",
    "\n",
    "        frames.append(df)\n",
    "\n",
    "        summary_rows.append({\n",
    "            \"TruthLabel\": label,\n",
    "            \"BeamEnergy_MeV\": energy,\n",
    "            \"CalibrationConstant\": C,\n",
    "            \"Nevents\": len(df),\n",
    "            \"NusedForCalibration\": int(df[\"UsedForCalibration\"].sum()),\n",
    "            \"Efficiency\": (df[\"TruthLabel\"] == df[\"PredictedType\"]).mean(),\n",
    "            \"Bias\": df[\"FracResidual\"].mean(),\n",
    "            \"Resolution\": df[\"FracResidual\"].std()\n",
    "        })\n",
    "\n",
    "    dataset = pd.concat(frames, ignore_index=True)\n",
    "    summary_df = pd.DataFrame(summary_rows).sort_values([\"TruthLabel\", \"BeamEnergy_MeV\"])\n",
    "\n",
    "    return dataset, summary_df"
   ]
  },
