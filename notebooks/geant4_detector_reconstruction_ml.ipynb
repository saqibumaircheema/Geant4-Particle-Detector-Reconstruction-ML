   "source": [
    "# Prepare Machine learning inputs\n",
    "#For Machine learning I am going to make new inputs and columns that is useful for the ML\n",
    "feature_cols = [\n",
    "    \"EM1\",\"EM2\",\"EM3\",\"EM4\",\"EM5\",\n",
    "    \"HCAL1\",\"HCAL2\",\"HCAL3\",\"HCAL4\",\"HCAL5\",\n",
    "    \"Si1\",\"Si2\",\"Si3\",\"Si4\",\"Si5\",\n",
    "    \"MuonGas\",\n",
    "    \"ECAL_sum\",\"HCAL_sum\",\"Tracker_sum\",\"Muon_sum\",\n",
    "    \"E_detected\",\n",
    "    \"ECAL_frac\",\"HCAL_frac\",\"HCAL_over_ECAL\",\n",
    "    \"ECAL_front_frac\",\"HCAL_back_frac\"\n",
    "]\n",
    "# This makes sure the ML models only see complete events.\n",
    "ml_full = dataset_full.dropna(subset=feature_cols + [\"TruthLabel\", \"TrueEnergy\"]).copy()\n",
    "# Create a combined label of particle type + beam energy.\n",
    "# This is used for stratified splitting so that the train/test sets\n",
    "# contain a balanced mixture of both particle classes and energies.\n",
    "ml_full[\"ClassEnergyLabel\"] = ml_full[\"TruthLabel\"] + \"_\" + ml_full[\"BeamEnergy_MeV\"].astype(str)\n",
    "\n",
    "X_full = ml_full[feature_cols].copy()\n",
    "y_full_class = ml_full[\"TruthLabel\"].copy()\n",
    "y_full_reg = ml_full[\"TrueEnergy\"].copy()\n",
    "\n",
    "# conventional baseline predictions\n",
    "# Keep the conventional reconstruction outputs as baselines.\n",
    "# These will later be compared with the ML results.\n",
    "baseline_pid_full = ml_full[\"PredictedType\"].copy()\n",
    "baseline_energy_full = ml_full[\"E_calibrated\"].copy()\n",
    "# Split into training and testing sets.\n",
    "# Important points:\n",
    "# test_size=0.2 means 80 percent  training, 20percent testing\n",
    "# shuffle=True randomises the event order\n",
    "# stratify=ClassEnergyLabel preserves the distribution of\n",
    "#   particle type AND beam energy in both train and test sets\n",
    "X_train, X_test, y_train_class, y_test_class, y_train_reg, y_test_reg, base_pid_train, base_pid_test, base_E_train, base_E_test = train_test_split(\n",
    "    X_full,\n",
    "    y_full_class,\n",
    "    y_full_reg,\n",
    "    baseline_pid_full,\n",
    "    baseline_energy_full,\n",
    "    test_size=0.2,\n",
    "    random_state=42,\n",
    "    shuffle=True,\n",
    "    stratify=ml_full[\"ClassEnergyLabel\"]\n",
    ")\n",
    "\n",
    "print(\"Train size:\", len(X_train))\n",
    "print(\"Test size :\", len(X_test))"
   ]
